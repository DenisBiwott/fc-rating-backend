            },
            "description": "List rating configs (requires admin role)\n\n`GET /rating-configs` · operationId `listRatingConfigs`\n\nRequires the **admin** role — run Auth → Log in first."
          }
        },
        {
          "name": "Create a rating config",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const value = pm.response.json().id",
                  "  pm.collectionVariables.set('configId', value)",
                  "  console.log('configId =', value)",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"elo-tuned-v1\",\n  \"algorithm\": \"elo\",\n  \"params\": {\n    \"baseline\": 1200,\n    \"kProvisional\": 32,\n    \"provisionalGames\": 10,\n    \"kEstablished\": 20,\n    \"drawScore\": 0.5,\n    \"expectationScale\": 400,\n    \"goalDifferenceFactor\": {\n      \"enabled\": true,\n      \"divisor\": 3,\n      \"cap\": 1.5\n    },\n    \"eliteK\": {\n      \"enabled\": true,\n      \"enterAt\": 1350,\n      \"exitAt\": 1320,\n      \"k\": 14,\n      \"requireEstablished\": true\n    },\n    \"repeatOpponentDamping\": {\n      \"enabled\": false,\n      \"threshold\": 3,\n      \"factor\": 0.85,\n      \"minMultiplier\": 0.3\n    },\n    \"maxDelta\": 35,\n    \"ratingFloor\": 900\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
