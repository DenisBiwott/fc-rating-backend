{
  "info": {
    "name": "FC Rating API",
    "description": "Every route in `openapi.json`, generated by `scripts/generate-postman.ts` — never hand-edit this file; regenerate it (`pnpm generate:postman`).\n\n**Setup:** import this collection and both environments from `fc-rating-backend/postman/`, pick an environment (top right), and set `adminPassword` — for Production, as the **Current value** only, so it's never synced to Postman's servers.\n\n**Use:** run **Auth → Log in with the shared admin password** first; Postman keeps the session cookie, so every request after it is logged in. IDs are captured as you go (`playerId`, `matchId`, `sessionId`, `configId`) and fill the `:id` of the requests that need them. For matches, set `homePlayerId`/`awayPlayerId` in the collection variables (copy IDs from **Players → List players**).\n\nFull guide: `docs/POSTMAN.md`. Adopting a rating config: `docs/RATING_CONFIGS.md`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "description": "Overridden by the selected environment."
    },
    {
      "key": "homePlayerId",
      "value": "",
      "description": "Set by hand, for the match requests."
    },
    {
      "key": "awayPlayerId",
      "value": "",
      "description": "Set by hand, for the match requests."
    },
    {
      "key": "playerId",
      "value": "",
      "description": "Captured by Players → Create a player."
    },
    {
      "key": "matchId",
      "value": "",
      "description": "Captured by Matches → Record a match result; idempotent on id."
    },
    {
      "key": "sessionId",
      "value": "",
      "description": "Captured by Sessions → Open a new session."
    },
    {
      "key": "configId",
      "value": "",
      "description": "Captured by Rating configs → Create a rating config."
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Check API and database health",
          "event": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check API and database health\n\n`GET /health` · operationId `getHealth`\n\nNo login needed."
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Log in with the shared admin password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logged in', () => pm.response.to.have.status(200))"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Log in with the shared admin password\n\n`POST /auth/login` · operationId `login`\n\nNo login needed.\n\nPostman keeps the session cookie in its cookie jar, so every request after this one is logged in. Rate-limited to 5 attempts per 15 minutes per IP (a 429 means wait)."
          }
        },
        {
          "name": "Get the current session's user, if any",
          "event": [],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Get the current session's user, if any\n\n`GET /auth/me` · operationId `getCurrentUser`\n\nNo login needed."
          }
        },
        {
          "name": "Clear the session cookie",
          "event": [],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Clear the session cookie\n\n`POST /auth/logout` · operationId `logout`\n\nNo login needed.\n\nLast in its folder on purpose: running the whole folder logs out at the end, not midway."
          }
        }
      ]
    },
